# Runtime
APP_ENV=development
RUN_MIGRATIONS=true
DATABASE_URL=postgresql://aeroledger:CHANGE_ME@localhost:5435/aeroledger
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS
HOST=127.0.0.1
PORT=8081
RUST_LOG=info
FRONTEND_URL=http://127.0.0.1:3001
PAYMENT_VERIFICATION_MODE=manual
RECONCILIATION_INTERVAL_SECONDS=60

# Wallets
WALLET_ADDRESS_BTC=CHANGE_ME
WALLET_ADDRESS_ETH=CHANGE_ME
WALLET_ADDRESS_SOL=CHANGE_ME
WALLET_ADDRESS_USDT=CHANGE_ME
WALLET_ADDRESS_USDC=CHANGE_ME
WALLET_ADDRESS_BNB=CHANGE_ME

# Chain APIs
ETHERSCAN_API_KEY=CHANGE_ME_ETHERSCAN_API_KEY

SOLANA_RPC_URL=CHANGE_ME_SOLANA_RPC_URL
BITCOIN_API_BASE=https://blockstream.info/api

# ── EVM chain identity ────────────────────────────────────────────────────────
# EIP-155 chain ids. These are served to the browser so the wallet connects to the
# same network the backend verifies against; a mismatch is how funds get sent to
# the right address on the wrong chain.
# 1 = Ethereum mainnet, 11155111 = Sepolia.
ETHEREUM_CHAIN_ID=1
# 56 = BSC mainnet, 97 = BSC testnet.
BSC_CHAIN_ID=56

# Required whenever a BSC route is enabled.
BSCSCAN_API_KEY=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Read by the browser at build time. Public values only — never put a secret here,
# it is compiled into the bundle.
VITE_API_BASE_URL=http://127.0.0.1:8081
# RPC the checkout uses for its SOL balance pre-flight. Must point at the same
# cluster as SOLANA_RPC_URL.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
