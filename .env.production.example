# Production environment template for docker-compose.prod.yml
# Copy to .env.production and fill in real values, then launch with:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

POSTGRES_DB=aeroledger
POSTGRES_USER=aeroledger
POSTGRES_PASSWORD=change-this-database-password

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
FRONTEND_URL=https://your-domain.example.com
FRONTEND_PORT=3000
RUST_LOG=info
RECONCILIATION_INTERVAL_SECONDS=60

WALLET_ADDRESS_BTC=bc1q-your-production-btc-wallet
WALLET_ADDRESS_ETH=0x-your-production-eth-wallet
WALLET_ADDRESS_SOL=your-production-solana-wallet
WALLET_ADDRESS_USDT=0x-your-production-usdt-wallet
WALLET_ADDRESS_USDC=0x-your-production-usdc-wallet
WALLET_ADDRESS_BNB=0x-your-production-bnb-wallet

ETHERSCAN_API_KEY=your-etherscan-key
BSCSCAN_API_KEY=your-bscscan-key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BITCOIN_API_BASE=https://blockstream.info/api
